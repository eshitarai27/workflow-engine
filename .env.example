# Everything below is optional -- FlowForge runs with zero configuration.

FLOWFORGE_HOST=0.0.0.0
FLOWFORGE_PORT=8000
FLOWFORGE_DB_PATH=data/flowforge.db
FLOWFORGE_CHECKPOINT_DIR=data/checkpoints
FLOWFORGE_LOG_LEVEL=INFO
FLOWFORGE_CORS_ORIGIN=*
FLOWFORGE_MAX_PARALLEL_NODES=8
FLOWFORGE_FS_ROOT=data/files

# AI-assisted workflow generation (optional; the platform works normally
# with none of these set -- /ai/generate just reports no provider configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# Plugin integrations (optional)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
